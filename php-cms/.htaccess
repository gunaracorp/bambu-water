# BWN PHP CMS — clean URLs
Options -Indexes
<IfModule mod_rewrite.c>
RewriteEngine On

# Lindungi file sensitif
RewriteRule ^(config\.php|lib/|data/.*\.json|data/.*\.sqlite|data/.*\.sqlite-.*)$ - [F,L]

# File/folder nyata (assets, images) dilayani langsung
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Semua rute → front controller
RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/css "access plus 7 days"
ExpiresByType application/javascript "access plus 7 days"
ExpiresByType image/jpeg "access plus 30 days"
ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>

# === SEO Universalis (v0.5.0) ===
AddDefaultCharset UTF-8
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-DNS-Prefetch-Control "on"
</IfModule>
# Panel admin: larang diindeks SEMUA mesin (header lebih kuat daripada meta)
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/admin#">
    Header set X-Robots-Tag "noindex, nofollow, noarchive"
  </If>
</IfModule>
