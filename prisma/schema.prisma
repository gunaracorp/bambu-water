generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String
  city      String?
  orderType String   @default("air-bambu")
  message   String
  status    String   @default("new")
  createdAt DateTime @default(now())
}
