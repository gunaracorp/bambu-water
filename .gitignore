# Bambu Water Nusantara — PHP 8.4 + SQLite (PHP-first repo)
# NEVER commit runtime secrets or databases to this public repo.

# Runtime database & cache (created automatically on first request)
/data/cms.sqlite
/data/cms.sqlite-journal
/data/cms.sqlite-wal
/data/cms.sqlite-shm
/data/cache/

# Local/private config overrides (credentials, SMTP, API keys)
.env
.env.*
config.local.php

# Uploads & session artifacts
/upload/
/tool-results/
/download/
/db/
*.db
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# Editor/OS noise
.DS_Store
*.log
*.bak
*.orig
*.pem

# Legacy Node.js era (kept ignored defensively; the stack is gone)
node_modules/
/.next/
/out/
.vercel
