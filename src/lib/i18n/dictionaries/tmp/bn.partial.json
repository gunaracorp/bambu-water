{"pages.artikel.h1": "\u09ac\u09be\u0981\u09b6\u09c7\u09b0 \u099c\u09b2\u09c7\u09b0 \u099c\u09cd\u099e\u09be\u09a8 \u0995\u09c7\u09a8\u09cd\u09a6\u09cd\u09b0", "pages.artikel.eyebrow": "\u09ac\u09cd\u09b2\u0997 \u0993 \u09a8\u09bf\u09ac\u09a8\u09cd\u09a7", "pages.artikel.intro": "\u09ac\u09be\u0981\u09b6\u09c7\u09b0 \u099c\u09b2 \u09b8\u09ae\u09cd\u09aa\u09b0\u09cd\u0995\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u09af\u09be \u099c\u09be\u09a8\u09be \u09aa\u09cd\u09b0\u09af\u09bc\u09cb\u099c\u09a8 \u2014 \u09ac\u09c8\u099c\u09cd\u099e\u09be\u09a8\u09bf\u0995 \u0997\u09ac\u09c7\u09b7\u09a3\u09be \u098f\u09ac\u0982 \u0987\u09a8\u09cd\u09a6\u09cb\u09a8\u09c7\u09b6\u09bf\u09af\u09bc\u09be\u09b0 \u0990\u09a4\u09bf\u09b9\u09cd\u09af\u09ac\u09be\u09b9\u09c0 \u099c\u09cd\u099e\u09be\u09a8 \u09a5\u09c7\u0995\u09c7 \u09b8\u0982\u0997\u09c3\u09b9\u09c0\u09a4\u0964", "pages.artikel.menuDesc": "\u09ac\u09be\u0981\u09b6\u09c7\u09b0 \u099c\u09b2\u09c7\u09b0 \u099c\u09cd\u099e\u09be\u09a8 \u0995\u09c7\u09a8\u09cd\u09a6\u09cd\u09b0", "pages.testimoni.navLabel": "\u09aa\u09cd\u09b0\u09a4\u09bf\u0995\u09cd\u09b0\u09bf\u09af\u09bc\u09be", "pages.testimoni.seoTitle": "\u0997\u09cd\u09b0\u09be\u09b9\u0995 \u09aa\u09cd\u09b0\u09a4\u09bf\u0995\u09cd\u09b0\u09bf\u09af\u09bc\u09be \u2014 BWN \u09ac\u09be\u0981\u09b6\u09c7\u09b0 \u099c\u09b2\u09c7\u09b0 \u09b8\u09c1\u09ac\u09bf\u09a7\u09be\u09b0 \u09aa\u09cd\u09b0\u0995\u09c3\u09a4 \u0997\u09b2\u09cd\u09aa", "pages.testimoni.metaDescription": "\u09ac\u09be\u09ae\u09cd\u09ac\u09c1 \u0993\u09af\u09bc\u09be\u099f\u09be\u09b0 \u09a8\u09c1\u09b8\u09be\u09a8\u09cd\u09a4\u09be\u09b0\u09be \u098f\u09b0 \u0997\u09cd\u09b0\u09be\u09b9\u0995\u09a6\u09c7\u09b0 \u09aa\u09cd\u09b0\u0995\u09c3\u09a4 \u0997\u09b2\u09cd\u09aa: \u09b8\u09cd\u09ac\u09be\u09b8\u09cd\u09a5\u09cd\u09af\u0995\u09b0 \u09aa\u09b0\u09bf\u09ac\u09be\u09b0, \u09ac\u09bf\u09b6\u09cd\u09ac\u09b8\u09cd\u09a4 \u09a5\u09c7\u09b0\u09be\u09aa\u09bf\u09b8\u09cd\u099f, \u098f\u09ac\u0982 \u0987\u09a8\u09cd\u09a6\u09cb\u09a8\u09c7\u09b6\u09bf\u09af\u09bc\u09be \u099c\u09c1\u09a1\u09bc\u09c7 \u09ac\u09bf\u09a4\u09b0\u09a3 \u0985\u0982\u09b6\u09c0\u09a6\u09be\u09b0\u0964", "pages.testimoni.h1": "\u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u0997\u09cd\u09b0\u09be\u09b9\u0995 \u09aa\u09cd\u09b0\u09a4\u09bf\u0995\u09cd\u09b0\u09bf\u09af\u09bc\u09be", "pages.testimoni.eyebrow": "\u09aa\u09cd\u09b0\u0995\u09c3\u09a4 \u0997\u09b2\u09cd\u09aa", "pages.testimoni.intro": "\u09aa\u09be\u09b0\u09bf\u09ac\u09be\u09b0\u09bf\u0995 \u09b0\u09be\u09a8\u09cd\u09a8\u09be\u0998\u09b0 \u09a5\u09c7\u0995\u09c7 \u09a5\u09c7\u09b0\u09be\u09aa\u09bf\u09b8\u09cd\u099f\u09c7\u09b0 \u0995\u09cd\u09b2\u09bf\u09a8\u09bf\u0995 \u09aa\u09b0\u09cd\u09af\u09a8\u09cd\u09a4 \u2014 BWN \u09ac\u09be\u0981\u09b6\u09c7\u09b0 \u099c\u09b2\u09c7\u09b0 \u09b8\u09c1\u09ac\u09bf\u09a7\u09be \u0985\u09a8\u09c1\u09ad\u09ac \u0995\u09b0\u09be \u09ae\u09be\u09a8\u09c1\u09b7\u09a6\u09c7\u09b0 \u098f\u0987 \u09a4\u09be\u09a6\u09c7\u09b0 \u0997\u09b2\u09cd\u09aa\u0964", "pages.testimoni.menuDesc": "\u0997\u09cd\u09b0\u09be\u09b9\u0995 \u09aa\u09cd\u09b0\u09a4\u09bf\u0995\u09cd\u09b0\u09bf\u09af\u09bc\u09be", "pages.faq.navLabel": "\u09b8\u09be\u09a7\u09be\u09b0\u09a3 \u09aa\u09cd\u09b0\u09b6\u09cd\u09a8", "pages.faq.seoTitle": "\u09b8\u09be\u09a7\u09be\u09b0\u09a3 \u09aa\u09cd\u09b0\u09b6\u09cd\u09a8 \u2014 \u09ac\u09be\u0981\u09b6\u09c7\u09b0 \u099c\u09b2 \u098f\u09ac\u0982 BWN \u09aa\u09b0\u09bf\u09b7\u09c7\u09ac\u09be \u09b8\u09ae\u09cd\u09aa\u09b0\u09cd\u0995\u09bf\u09a4 \u09aa\u09cd\u09b0\u09b6\u09cd\u09a8", "pages.faq.metaDescription": "\u09b8\u09be\u09a7\u09be\u09b0\u09a3 \u09aa\u09cd\u09b0\u09b6\u09cd\u09a8\u09c7\u09b0 \u09b8\u09ae\u09cd\u09aa\u09c2\u09b0\u09cd\u09a3 \u0989\u09a4\u09cd\u09a4\u09b0: \u09ac\u09be\u0981\u09b6\u09c7\u09b0 \u099c\u09b2 \u0995\u09bf, \u09a6\u09c8\u09a8\u09bf\u0995 \u09a8\u09bf\u09b0\u09be\u09aa\u09a4\u09cd\u09a4\u09be, \u09aa\u09a3\u09cd\u09af\u09c7\u09b0 \u09aa\u09be\u09b0\u09cd\u09a5\u0995\u09cd\u09af, \u09aa\u09be\u0987\u0995\u09be\u09b0\u09bf \u0995\u09bf\u09ad\u09be\u09ac\u09c7 \u0985\u09b0\u09cd\u09a1\u09be\u09b0 \u0995\u09b0\u09ac\u09c7\u09a8, \u09b6\u09bf\u09aa\u09bf\u0982, \u098f\u09ac\u0982 \u0995\u09cb\u09ae\u09cd\u09aa\u09be\u09a8\u09bf\u09b0 \u09ac\u09c8\u09a7\u09a4\u09be\u0964", "pages.faq.h1": "\u09b8\u09be\u09a7\u09be\u09b0\u09a3\u09a4 \u099c\u09bf\u099c\u09cd\u099e\u09be\u09b8\u09bf\u09a4 \u09aa\u09cd\u09b0\u09b6\u09cd\u09a8", "pages.faq.eyebrow": "\u09b8\u09be\u09b9\u09be\u09af\u09cd\u09af \u0993 \u09a4\u09a5\u09cd\u09af", "pages.faq.intro": "\u09ac\u09be\u0981\u09b6\u09c7\u09b0 \u099c\u09b2, \u09aa\u09a3\u09cd\u09af, \u0985\u09b0\u09cd\u09a1\u09be\u09b0 \u098f\u09ac\u0982 \u09b6\u09bf\u09aa\u09bf\u0982 \u09b8\u09ae\u09cd\u09aa\u09b0\u09cd\u0995\u09c7 \u09b8\u09ae\u09b8\u09cd\u09a4 \u09aa\u09cd\u09b0\u09b6\u09cd\u09a8 \u2014 \u098f\u0995\u099f\u09bf \u09aa\u09c3\u09b7\u09cd\u09a0\u09be\u09af\u09bc \u09b8\u09ae\u09cd\u09aa\u09c2\u09b0\u09cd\u09a3 \u0989\u09a4\u09cd\u09a4\u09b0\u0964", "pages.faq.menuDesc": "\u09b8\u09be\u09a7\u09be\u09b0\u09a3\u09a4 \u099c\u09bf\u099c\u09cd\u099e\u09be\u09b8\u09bf\u09a4 \u09aa\u09cd\u09b0\u09b6\u09cd\u09a8", "pages.kontak.navLabel": "\u09af\u09cb\u0997\u09be\u09af\u09cb\u0997", "pages.kontak.seoTitle": "\u09af\u09cb\u0997\u09be\u09af\u09cb\u0997 \u0993 \u0985\u09b0\u09cd\u09a1\u09be\u09b0 \u2014 WhatsApp 0813-1651-6524 | \u09ac\u09be\u09ae\u09cd\u09ac\u09c1 \u0993\u09af\u09bc\u09be\u099f\u09be\u09b0 \u09a8\u09c1\u09b8\u09be\u09a8\u09cd\u09a4\u09be\u09b0\u09be", "pages.kontak.metaDescription": "\u09aa\u09bf\u099f\u09bf \u09ac\u09be\u09ae\u09cd\u09ac\u09c1 \u0993\u09af\u09bc\u09be\u099f\u09be\u09b0 \u09a8\u09c1\u09b8\u09be\u09a8\u09cd\u09a4\u09be\u09b0\u09be\u09b0 \u09b8\u09be\u09a5\u09c7 \u09af\u09cb\u0997\u09be\u09af\u09cb\u0997 \u0995\u09b0\u09c1\u09a8: WhatsApp 0813-1651-6524, \u0987\u09ae\u09c7\u09b2, \u0985\u09b0\u09cd\u09a1\u09be\u09b0 \u09ab\u09b0\u09ae\u0964 \u09a5\u09c7\u09b0\u09be\u09aa\u09bf \u098f\u09ac\u0982 \u09aa\u09be\u0987\u0995\u09be\u09b0\u09bf \u09aa\u09cd\u09b0\u09af\u09bc\u09cb\u099c\u09a8\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u09ac\u09bf\u09a8\u09be\u09ae\u09c2\u09b2\u09cd\u09af\u09c7 \u09aa\u09b0\u09be\u09ae\u09b0\u09cd\u09b6\u0964", "pages.kontak.h1": "\u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u09af\u09cb\u0997\u09be\u09af\u09cb\u0997 \u0995\u09b0\u09c1\u09a8 \u2014 \u09ac\u09bf\u09a8\u09be\u09ae\u09c2\u09b2\u09cd\u09af\u09c7 \u09aa\u09b0\u09be\u09ae\u09b0\u09cd\u09b6", "pages.kontak.eyebrow": "\u09af\u09cb\u0997\u09be\u09af\u09cb\u0997 \u0993 \u0985\u09b0\u09cd\u09a1\u09be\u09b0", "pages.kontak.intro": "\u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u09a6\u09b2 \u09aa\u09be\u09b0\u09bf\u09ac\u09be\u09b0\u09bf\u0995 \u09a5\u09c7\u09b0\u09be\u09aa\u09bf \u09a5\u09c7\u0995\u09c7 \u09ac\u09c3\u09b9\u09ce \u09ac\u09bf\u09a4\u09b0\u09a3 \u099a\u09c1\u0995\u09cd\u09a4\u09bf \u09aa\u09b0\u09cd\u09af\u09a8\u09cd\u09a4 \u0986\u09aa\u09a8\u09be\u09b0 \u09aa\u09cd\u09b0\u09af\u09bc\u09cb\u099c\u09a8 \u09b8\u09be\u09b9\u09be\u09af\u09cd\u09af \u0995\u09b0\u09a4\u09c7 \u09aa\u09cd\u09b0\u09b8\u09cd\u09a4\u09c1\u09a4\u0964 \u0995\u09b0\u09cd\u09ae\u0998\u09a3\u09cd\u099f\u09be\u09af\u09bc \u09a6\u09cd\u09b0\u09c1\u09a4 \u0989\u09a4\u09cd\u09a4\u09b0\u0964"}